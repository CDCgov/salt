bodyHtml += '// The modal is dismissed only via the X button or the Cancel button.\n';
bodyHtml += '\n';
bodyHtml += '// Audio recording functionality\n';
bodyHtml += 'let mediaRecorder = null;\n';
bodyHtml += 'let audioChunks = [];\n';
bodyHtml += 'let currentRecordingLang = null;\n';
bodyHtml += '\n';
bodyHtml += '// Function to trim silence from audio buffer\n';
bodyHtml += 'function trimSilence(audioBuffer, options = {}) {\n';
bodyHtml += '    const {\n';
bodyHtml += '        threshold = 0.01,      // Silence threshold (0-1 range)\n';
bodyHtml += '        windowMs = 10,         // Window size for RMS calculation\n';
bodyHtml += '        paddingMs = 100,       // Padding to keep at boundaries\n';
bodyHtml += '        minLengthMs = 500      // Minimum audio length after trimming\n';
bodyHtml += '    } = options;\n';
bodyHtml += '    \n';
bodyHtml += '    const sampleRate = audioBuffer.sampleRate;\n';
bodyHtml += '    const windowSize = Math.floor(sampleRate * windowMs / 1000);\n';
bodyHtml += '    const padding = Math.floor(sampleRate * paddingMs / 1000);\n';
bodyHtml += '    const minSamples = Math.floor(sampleRate * minLengthMs / 1000);\n';
bodyHtml += '    \n';
bodyHtml += '    // Get audio data from all channels\n';
bodyHtml += '    const channels = [];\n';
bodyHtml += '    for (let i = 0; i < audioBuffer.numberOfChannels; i++) {\n';
bodyHtml += '        channels.push(audioBuffer.getChannelData(i));\n';
bodyHtml += '    }\n';
bodyHtml += '    \n';
bodyHtml += '    // Calculate RMS for each window\n';
bodyHtml += '    function calculateRMS(samples, start, length) {\n';
bodyHtml += '        let sum = 0;\n';
bodyHtml += '        const end = Math.min(start + length, samples.length);\n';
bodyHtml += '        for (let i = start; i < end; i++) {\n';
bodyHtml += '            sum += samples[i] * samples[i];\n';
bodyHtml += '        }\n';
bodyHtml += '        return Math.sqrt(sum / (end - start));\n';
bodyHtml += '    }\n';
bodyHtml += '    \n';
bodyHtml += '    // Find start of non-silence\n';
bodyHtml += '    let startSample = 0;\n';
bodyHtml += '    const firstChannel = channels[0];\n';
bodyHtml += '    for (let i = 0; i < firstChannel.length - windowSize; i += windowSize) {\n';
bodyHtml += '        const rms = calculateRMS(firstChannel, i, windowSize);\n';
bodyHtml += '        if (rms > threshold) {\n';
bodyHtml += '            startSample = Math.max(0, i - padding);\n';
bodyHtml += '            break;\n';
bodyHtml += '        }\n';
bodyHtml += '    }\n';
bodyHtml += '    \n';
bodyHtml += '    // Find end of non-silence\n';
bodyHtml += '    let endSample = firstChannel.length;\n';
bodyHtml += '    for (let i = firstChannel.length - windowSize; i > startSample; i -= windowSize) {\n';
bodyHtml += '        const rms = calculateRMS(firstChannel, i, windowSize);\n';
bodyHtml += '        if (rms > threshold) {\n';
bodyHtml += '            endSample = Math.min(firstChannel.length, i + windowSize + padding);\n';
bodyHtml += '            break;\n';
bodyHtml += '        }\n';
bodyHtml += '    }\n';
bodyHtml += '    \n';
bodyHtml += '    // Ensure minimum length\n';
bodyHtml += '    const trimmedLength = endSample - startSample;\n';
bodyHtml += '    if (trimmedLength < minSamples) {\n';
bodyHtml += '        // If too short after trimming, keep more of the original\n';
bodyHtml += '        const centerPoint = (startSample + endSample) / 2;\n';
bodyHtml += '        startSample = Math.max(0, Math.floor(centerPoint - minSamples / 2));\n';
bodyHtml += '        endSample = Math.min(firstChannel.length, Math.floor(centerPoint + minSamples / 2));\n';
bodyHtml += '    }\n';
bodyHtml += '    \n';
bodyHtml += '    // Create new audio buffer with trimmed audio\n';
bodyHtml += '    const trimmedLength2 = endSample - startSample;\n';
bodyHtml += '    // Create a new audio context since the original might be closed\n';
bodyHtml += '    const newContext = new (window.AudioContext || window.webkitAudioContext)();\n';
bodyHtml += '    const trimmedBuffer = newContext.createBuffer(\n';
bodyHtml += '        audioBuffer.numberOfChannels,\n';
bodyHtml += '        trimmedLength2,\n';
bodyHtml += '        sampleRate\n';
bodyHtml += '    );\n';
bodyHtml += '    \n';
bodyHtml += '    // Copy trimmed audio to new buffer with fade in/out\n';
bodyHtml += '    const fadeLength = Math.min(Math.floor(sampleRate * 0.01), Math.floor(trimmedLength2 / 10)); // 10ms or 10% of length\n';
bodyHtml += '    for (let channel = 0; channel < audioBuffer.numberOfChannels; channel++) {\n';
bodyHtml += '        const sourceData = channels[channel];\n';
bodyHtml += '        const targetData = trimmedBuffer.getChannelData(channel);\n';
bodyHtml += '        \n';
bodyHtml += '        for (let i = 0; i < trimmedLength2; i++) {\n';
bodyHtml += '            let sample = sourceData[startSample + i];\n';
bodyHtml += '            \n';
bodyHtml += '            // Apply fade in\n';
bodyHtml += '            if (i < fadeLength) {\n';
bodyHtml += '                sample *= i / fadeLength;\n';
bodyHtml += '            }\n';
bodyHtml += '            // Apply fade out\n';
bodyHtml += '            else if (i > trimmedLength2 - fadeLength) {\n';
bodyHtml += '                sample *= (trimmedLength2 - i) / fadeLength;\n';
bodyHtml += '            }\n';
bodyHtml += '            \n';
bodyHtml += '            targetData[i] = sample;\n';
bodyHtml += '        }\n';
bodyHtml += '    }\n';
bodyHtml += '    \n';
bodyHtml += '    console.log(`Trimmed audio from ${audioBuffer.length} to ${trimmedLength2} samples (${(startSample/sampleRate).toFixed(2)}s - ${(endSample/sampleRate).toFixed(2)}s)`);\n';
bodyHtml += '    \n';
bodyHtml += '    return trimmedBuffer;\n';
bodyHtml += '}\n';
bodyHtml += '\n';
bodyHtml += '// Convert audio blob to MP3 using lamejs\n';
bodyHtml += 'async function convertToMp3(audioBlob) {\n';
bodyHtml += '    return new Promise(async (resolve, reject) => {\n';
bodyHtml += '        try {\n';
bodyHtml += '            // Create audio context to decode the WebM audio\n';
bodyHtml += '            const audioContext = new (window.AudioContext || window.webkitAudioContext)();\n';
bodyHtml += '            const arrayBuffer = await audioBlob.arrayBuffer();\n';
bodyHtml += '            const audioBuffer = await audioContext.decodeAudioData(arrayBuffer);\n';
bodyHtml += '            \n';
bodyHtml += '            // Trim silence from the audio\n';
bodyHtml += '            const trimmedBuffer = trimSilence(audioBuffer);\n';
bodyHtml += '            \n';
bodyHtml += '            // Get audio data from trimmed buffer\n';
bodyHtml += '            const channels = trimmedBuffer.numberOfChannels;\n';
bodyHtml += '            const sampleRate = trimmedBuffer.sampleRate;\n';
bodyHtml += '            const samples = trimmedBuffer.length;\n';
bodyHtml += '            \n';
bodyHtml += '            // Convert to 16-bit PCM\n';
bodyHtml += '            const leftChannel = trimmedBuffer.getChannelData(0);\n';
bodyHtml += '            const rightChannel = channels > 1 ? trimmedBuffer.getChannelData(1) : leftChannel;\n';
bodyHtml += '            \n';
bodyHtml += '            // Convert float samples to 16-bit PCM\n';
bodyHtml += '            const left = new Int16Array(samples);\n';
bodyHtml += '            const right = new Int16Array(samples);\n';
bodyHtml += '            for (let i = 0; i < samples; i++) {\n';
bodyHtml += '                left[i] = Math.max(-32768, Math.min(32767, leftChannel[i] * 32768));\n';
bodyHtml += '                right[i] = Math.max(-32768, Math.min(32767, rightChannel[i] * 32768));\n';
bodyHtml += '            }\n';
bodyHtml += '            \n';
bodyHtml += '            // Create MP3 encoder\n';
bodyHtml += '            const mp3Encoder = new lamejs.Mp3Encoder(channels, sampleRate, 128);\n';
bodyHtml += '            const mp3Data = [];\n';
bodyHtml += '            \n';
bodyHtml += '            // Encode in chunks\n';
bodyHtml += '            const blockSize = 1152;\n';
bodyHtml += '            for (let i = 0; i < samples; i += blockSize) {\n';
bodyHtml += '                const leftChunk = left.subarray(i, Math.min(i + blockSize, samples));\n';
bodyHtml += '                const rightChunk = right.subarray(i, Math.min(i + blockSize, samples));\n';
bodyHtml += '                const mp3buf = mp3Encoder.encodeBuffer(leftChunk, rightChunk);\n';
bodyHtml += '                if (mp3buf.length > 0) {\n';
bodyHtml += '                    mp3Data.push(mp3buf);\n';
bodyHtml += '                }\n';
bodyHtml += '            }\n';
bodyHtml += '            \n';
bodyHtml += '            // Flush encoder\n';
bodyHtml += '            const mp3buf = mp3Encoder.flush();\n';
bodyHtml += '            if (mp3buf.length > 0) {\n';
bodyHtml += '                mp3Data.push(mp3buf);\n';
bodyHtml += '            }\n';
bodyHtml += '            \n';
bodyHtml += '            // Create blob and convert to base64\n';
bodyHtml += '            const mp3Blob = new Blob(mp3Data, { type: "audio/mp3" });\n';
bodyHtml += '            const reader = new FileReader();\n';
bodyHtml += '            reader.onloadend = () => {\n';
bodyHtml += '                resolve(reader.result);\n';
bodyHtml += '            };\n';
bodyHtml += '            reader.onerror = reject;\n';
bodyHtml += '            reader.readAsDataURL(mp3Blob);\n';
bodyHtml += '        } catch (error) {\n';
bodyHtml += '            reject(error);\n';
bodyHtml += '        }\n';
bodyHtml += '    });\n';
bodyHtml += '}\n';
