<% var body = ` 
<h2>Survey Configuration</h2>

<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3>Survey Versions</h3>
        <div style="display: flex; gap: 0.5rem;">
            <input type="file" id="importFileInput" accept="application/json,.json" style="display: none;" onchange="importSurvey(this.files[0])">
            <button class="btn" onclick="document.getElementById('importFileInput').click()">Import Survey</button>
            <a href="/surveys/new" class="btn">Create New Survey</a>
        </div>
    </div>
    
    <table>
        <thead>
            <tr>
                <th>Version</th>
                <th>Name</th>
                <th>Description</th>
                <th>Languages</th>
                <th>Questions</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            ${surveys.map(survey => `
                <tr>
                    <td>v${h(survey.version)}</td>
                    <td>${h(survey.name)}</td>
                    <td>${h(survey.description || '-')}</td>
                    <td>${h(survey.languages ? (typeof survey.languages === 'string' ? JSON.parse(survey.languages).join(', ') : survey.languages.join(', ')) : 'en')}</td>
                    <td>${h(survey.question_count)}</td>
                    <td>
                        ${survey.is_active ? 
                            '<span style="color: green; font-weight: bold;">Active</span>' : 
                            '<span style="color: gray;">Inactive</span>'
                        }
                    </td>
                    <td>
                        <a href="/surveys/${h(survey.id)}/edit" class="btn" style="padding: 0.25rem 0.5rem;">Edit</a>
                        ${!survey.is_active ? 
                            `<button data-survey-id="${h(survey.id)}" onclick="activateSurvey(this.dataset.surveyId)" class="btn" style="padding: 0.25rem 0.5rem; margin-left: 0.5rem;">Activate</button>` : 
                            ''
                        }
                        <button data-survey-id="${h(survey.id)}" onclick="cloneSurvey(Number(this.dataset.surveyId))" class="btn" style="padding: 0.25rem 0.5rem; margin-left: 0.5rem;">Clone</button>
                        ${!survey.is_active ? 
                            `<button data-survey-id="${h(survey.id)}" data-survey-name="${h(survey.name)}" onclick="deleteSurvey(this.dataset.surveyId, this.dataset.surveyName)" class="btn btn-danger" style="padding: 0.25rem 0.5rem; margin-left: 0.5rem;">Delete</button>` : 
                            ''
                        }
                    </td>
                </tr>
            `).join('')}
            ${surveys.length === 0 ? '<tr><td colspan="6" style="text-align: center;">No surveys configured</td></tr>' : ''}
        </tbody>
    </table>
</div>

<script>
// Plain-text summary of a JEXL check result, for alert() dialogs.
function formatJexlCheck(check, max) {
    if (!check) return '';
    max = max || 15;
    const lines = [];
    const errors = check.errors || [];
    const warnings = check.warnings || [];
    if (errors.length) {
        lines.push('Script errors (' + errors.length + '):');
        errors.slice(0, max).forEach(function (i) { lines.push('• ' + i.message); });
        if (errors.length > max) lines.push('… and ' + (errors.length - max) + ' more.');
    }
    if (warnings.length) {
        if (lines.length) lines.push('');
        lines.push('Script warnings (' + warnings.length + '):');
        warnings.slice(0, max).forEach(function (i) { lines.push('• ' + i.message); });
        if (warnings.length > max) lines.push('… and ' + (warnings.length - max) + ' more.');
    }
    if (lines.length) lines.push('', 'Open the survey editor and use "Check survey" to see them all.');
    return lines.join('\\n');
}

async function activateSurvey(surveyId) {
    if (!confirm('Activate this survey? This will deactivate all other surveys.')) {
        return;
    }
    
    try {
        const response = await fetch('/api/admin/survey-config/' + surveyId + '/activate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        
        const result = await response.json();
        
        if (response.ok) {
            const warnings = result.jexl_check && result.jexl_check.warnings ? result.jexl_check.warnings.length : 0;
            alert('Survey activated successfully' + (warnings ? '\\n\\n' + formatJexlCheck({ warnings: result.jexl_check.warnings }, 5) : ''));
            location.reload();
        } else {
            alert('Failed to activate survey: ' + result.error
                + (result.jexl_check ? '\\n\\n' + formatJexlCheck(result.jexl_check) : ''));
        }
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

async function cloneSurvey(surveyId) {
    const name = prompt('Enter name for the cloned survey:');
    if (!name) return;
    
    try {
        const response = await fetch('/api/admin/survey-config', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name: name,
                description: 'Cloned survey',
                basedOnSurveyId: surveyId
            })
        });
        
        const result = await response.json();
        
        if (response.ok) {
            alert('Survey cloned successfully as version ' + result.version);
            location.reload();
        } else {
            alert('Failed to clone survey: ' + result.error);
        }
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

async function deleteSurvey(surveyId, surveyName) {
    // Double confirmation for safety
    if (!confirm('Are you sure you want to delete the survey "' + surveyName + '"?\\n\\nThis action cannot be undone.')) {
        return;
    }
    
    if (!confirm('This will permanently delete all questions and options for "' + surveyName + '". Are you absolutely sure?')) {
        return;
    }
    
    try {
        const response = await fetch('/api/admin/survey-config/' + surveyId, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' }
        });
        
        const result = await response.json();
        
        if (response.ok) {
            alert('Survey deleted successfully');
            location.reload();
        } else {
            alert('Failed to delete survey: ' + result.error);
        }
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

async function importSurvey(file) {
    if (!file) return;
    let bundle;
    try {
        const text = await file.text();
        bundle = JSON.parse(text);
    } catch (e) {
        alert('Could not read file as JSON: ' + e.message);
        return;
    }
    const sName = bundle && bundle.survey && bundle.survey.name;
    const qCount = (bundle && bundle.questions && bundle.questions.length) || 0;
    if (!sName) {
        alert('Not a valid SALT survey export — missing survey.name.');
        document.getElementById('importFileInput').value = '';
        return;
    }
    if (!confirm(\`Import "\${sName}" (\${qCount} questions)? A new survey row will be created (is_active=false, is_draft=true).\`)) {
        document.getElementById('importFileInput').value = '';
        return;
    }
    try {
        const response = await fetch('/api/admin/surveys/import', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(bundle)
        });
        const result = await response.json();
        if (!response.ok || result.status !== 'success') {
            throw new Error(result.message || 'Import failed');
        }
        let msg = \`Imported "\${result.name}" v\${result.version}.\`;
        if (result.warnings && result.warnings.length) {
            msg += '\\n\\nWarnings:\\n• ' + result.warnings.join('\\n• ');
        }
        const scriptReport = formatJexlCheck(result.jexl_check, 10);
        if (scriptReport) {
            msg += '\\n\\n' + scriptReport;
        }
        alert(msg);
        window.location.href = '/surveys/' + result.surveyId + '/edit';
    } catch (e) {
        alert('Import failed: ' + e.message);
    } finally {
        document.getElementById('importFileInput').value = '';
    }
}
</script>
` %>
<%- include('../layouts/main', { body: body }) %>